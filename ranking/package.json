{
  "name": "taiman-senki-ranking",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "firebase emulators:exec --only firestore --project demo-taiman \"node --test --test-concurrency=1 test/rules.test.mjs test/online-rules.test.mjs\"",
    "emulators": "firebase emulators:start --only firestore,auth --project demo-taiman",
    "test:page": "firebase emulators:exec --only firestore,auth --project demo-taiman \"node test/page.test.mjs\"",
    "test:game": "firebase emulators:exec --only firestore,auth --project demo-taiman \"node test/game.test.mjs\"",
    "test:transfer": "firebase emulators:exec --only firestore,auth --project demo-taiman \"node test/transfer.test.mjs\"",
    "test:online": "firebase emulators:exec --only firestore,auth --project demo-taiman \"node test/online.test.mjs\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "firebase": "12.19.0",
    "firebase-tools": "15.31.0",
    "playwright": "^1.56.1"
  }
}
